  "light": {
    "intro": "絵の具の色は、光のうちどの色をはね返し、どの色を吸いこむかで決まります。下の棒は、それぞれの絵の具が赤・緑・青の光をどれだけはね返すかの目安です。混ぜると、どちらの絵の具にも吸いこまれなかった光だけが残ります。",
    "ids": [
      "r",
      "ro",
      "y",
      "b",
      "u",
      "m",
      "c"
    ]
  },
  "purple": {
    "intro": "紫は、赤い光と青い光の両方をはね返す色です。ふつうの赤(朱寄り)は青い光を、緑みの青は赤い光を強く吸いこむため、混ぜると光がほとんど残らず、暗くにごった紫になります。赤と青の2色だけでも、種類を選ぶと紫はきれいになります。",
    "rows": [
      "r",
      "ro"
    ],
    "cols": [
      "b",
      "u"
    ],
    "points": [
      {
        "title": "赤は「青みの赤」を選ぶ",
        "desc": "ローズ、クリムゾンレーキ、カーマインなど赤紫寄りの赤です。マゼンタはこの方向の一番はしの色です。朱色寄りの赤に含まれる黄みは、青と混ざるとにごりのもとになります。"
      },
      {
        "title": "青は「赤みの青」を選ぶ",
        "desc": "ウルトラマリンです。フタロブルーのような緑みの青は、赤い光を強く吸いこむので紫がにごりやすくなります。"
      },
      {
        "title": "白を少し足す",
        "desc": "暗い紫はにごって見えやすいので、白で明るくするとすっきり見えます。水彩なら水で薄めても同じ効果があります。"
      },
      {
        "title": "混ぜずに重ねる(重色)",
        "desc": "水彩で、赤を塗って乾かしてから青を薄く重ねると、パレットで混ぜるより澄んだ色に見えます。下の色が紙の白を透かして見えるためです。"
      },
      {
        "title": "紫の絵の具を使う",
        "desc": "それでも、紫の顔料そのもの(バイオレット系)の鮮やかさには届きません。鮮やかな紫を多く使う時は、紫の絵の具を1本用意します。"
      }
    ],
    "glaze": {
      "a": "ro",
      "b": "u",
      "desc": "同じ2色でも、パレットで混ぜた色(左)と、薄く塗って乾かしてから重ねた色(右)では見え方が変わります(右は目安の表示です)。"
    }
  },
  "recipes": [
    {
      "name": "橙(オレンジ)",
      "parts": {
        "r": 1,
        "y": 2
      },
      "tip": "黄に赤を少しずつ足します。赤を増やすと朱色に近づきます。"
    },
    {
      "name": "緑",
      "parts": {
        "y": 1,
        "b": 1
      },
      "tip": "黄と青を同じくらい。青のかわりにシアンを使うと、鮮やかな緑になります。"
    },
    {
      "name": "黄緑",
      "parts": {
        "y": 3,
        "b": 1
      },
      "tip": "黄を多めにして、青はほんの少し。"
    },
    {
      "name": "紫",
      "parts": {
        "r": 1,
        "b": 1
      },
      "tip": "ふつうの赤と青だと、くすんだ紫になります。"
    },
    {
      "name": "鮮やかな紫",
      "parts": {
        "m": 2,
        "b": 1
      },
      "tip": "マゼンタと青で作ります。くわしくは「紫をきれいに作る」の章を見てください。"
    },
    {
      "name": "澄んだ紫",
      "parts": {
        "ro": 1,
        "u": 1
      },
      "tip": "青みの赤(ローズ)と赤みの青(ウルトラマリン)の2色で作ります。"
    },
    {
      "name": "茶色",
      "parts": {
        "r": 2,
        "y": 1,
        "b": 1
      },
      "tip": "三原色を混ぜると茶色になります。橙に少し黒を足す作り方もあります。"
    },
    {
      "name": "こげ茶",
      "parts": {
        "r": 1,
        "y": 1,
        "b": 1,
        "k": 1
      },
      "tip": "茶色に黒を足して暗くします。"
    },
    {
      "name": "黄土色",
      "parts": {
        "y": 3,
        "r": 1,
        "k": 1
      },
      "tip": "黄に赤と黒を少しずつ。土や木の色に使います。"
    },
    {
      "name": "うすだいだい",
      "parts": {
        "w": 6,
        "y": 1,
        "r": 1
      },
      "tip": "白をたっぷり出し、黄と赤をほんの少しずつ。人によって黄や茶を足して調整します。"
    },
    {
      "name": "ピンク",
      "parts": {
        "w": 3,
        "r": 1
      },
      "tip": "白に赤を少しずつ。マゼンタを使うと青みのピンクになります。"
    },
    {
      "name": "水色",
      "parts": {
        "w": 3,
        "b": 1
      },
      "tip": "白に青を少しずつ。シアンを使うと明るい空色になります。"
    },
    {
      "name": "灰色",
      "parts": {
        "w": 3,
        "k": 1
      },
      "tip": "白に黒をほんの少し。黒は強いので一気に入れないようにします。"
    },
    {
      "name": "紺",
      "parts": {
        "b": 3,
        "k": 1
      },
      "tip": "青に黒を少し足します。"
    },
    {
      "name": "オリーブ",
      "parts": {
        "y": 3,
        "k": 1
      },
      "tip": "黄に黒を足すと、緑がかった色になります。"
    }
  ],
